# Valve's artwork, extracted from the local CS2 install by tools/extract_icons.py.
# Each user should run that script against their own game install.
viewer/icons/

# demos are hundreds of MB - never commit them
*.dem
# where the browser upload puts them. Covered by *.dem already; named so the
# directory is obviously not repo content.
data/demos/

# parser output + caches
data/*.json
!data/_sample_mirage.json

# Extracted voice comms. These are recordings of identifiable people talking -
# they belong to the match, not to the repo, and must never be committed.
data/voice/
__pycache__/
.pytest_cache/

# nothing here should ever hold a key; belt and braces
*.key
.env
.env.*

# Brag video. The SOURCE is worth keeping - the plan, the brief, the share copy
# and the hand-authored composition are all small text with real decisions in
# them. Only the heavy artifacts are ignored: the render, the poster, the 2.7 MB
# music bed, the SFX, the vendored GSAP and the snapshot PNGs.
brag-output/brag.mp4
brag-output/brag.jpg
brag-output/composition/assets/
brag-output/composition/vendor/
brag-output/composition/snapshots/
brag-output/composition/renders/

# Tool scratch state, not project content.
.claude-flow/
